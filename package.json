{
  "name": "@openwaters/chs-constituents",
  "version": "0.3.1",
  "description": "Fit tidal-current harmonic constituents from published predictions, in the browser or on a SignalK server",
  "license": "MIT",
  "keywords": [
    "tides",
    "currents",
    "harmonic-constituents",
    "chs",
    "iwls",
    "tidal-prediction",
    "signalk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/chs-constituents.git"
  },
  "homepage": "https://openwaters.io",
  "bugs": {
    "url": "https://github.com/openwatersio/chs-constituents/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check:boundary": "node scripts/check-boundary.mjs",
    "prepublishOnly": "npm run build && npm run check:boundary",
    "fit": "tsc && node dist/cli.js"
  },
  "dependencies": {
    "@neaps/tide-predictor": "^0.11.0",
    "@openwaters/station-metadata": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "bin": {
    "chs-constituents": "dist/cli.js"
  }
}
